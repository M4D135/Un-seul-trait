{
  "name": "un-seul-trait",
  "version": "1.4.0",
  "private": true,
  "description": "Un jeu de plateforme et de dessin en français, inspiré de La Linea.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config scripts/public-vite.config.mjs",
    "build": "node scripts/public-build.mjs --out dist",
    "preview": "vite preview --config scripts/public-vite.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/public-test.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
